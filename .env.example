# Puerto local del servidor
PORT=3000
# Credenciales fijas de acceso (datos semilla). No se cambian desde la aplicación.
SEED_USERNAME=
SEED_PASSWORD=
# 32 bytes en base64. Generar con:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
ENCRYPTION_KEY=
# Opcional: ruta a Chrome/Chromium si Puppeteer no descarga el suyo
# PUPPETEER_EXECUTABLE_PATH=
# Opcional: URL base de Alegra (por defecto https://api.alegra.com/api/v1)
# ALEGRA_BASE_URL=
