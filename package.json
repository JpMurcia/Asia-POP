{
  "name": "asia-pop-catalog",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "workspaces": [
    "backend",
    "frontend"
  ],
  "scripts": {
    "dev": "npm run dev -w backend",
    "build": "npm run build -w frontend && npm run typecheck -w backend",
