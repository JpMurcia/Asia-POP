    "test:pdf": "npm run test:pdf -w backend",
    "lint": "eslint ."
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.12.0",
    "prettier": "^3.9.9",
    "typescript-eslint": "^8.71.0"
  }
}
